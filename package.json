    "build:plugin": "node scripts/build-plugin.mjs",
    "smoke:plugin": "node scripts/plugin-smoke.mjs"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "subtitles",
    "legendas",
    "portugues",
    "turkish-series"
  ],
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
